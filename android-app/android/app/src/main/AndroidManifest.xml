<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Long-press shortcuts on the app icon: catat dengan suara / ketik -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

            <!-- Family invite read from another phone over NFC (see KasNfcPlugin) -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="fatahilahuda.github.io" android:pathPrefix="/kas-keluarga" />
            </intent-filter>

        </activity>

        <!-- Catat cepat popup over the home screen (widget, shortcuts, Quick Settings tile) -->
        <activity
            android:name=".QuickAddActivity"
            android:label="@string/quick_label"
            android:theme="@style/AppTheme.Quick.Blur"
            android:exported="true"
            android:taskAffinity="io.github.fatahilahuda.muarakas.quick"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density" />

        <!-- Digital assistant: long-press side key / corner swipe opens catat suara (Setelan → Aplikasi default) -->
        <activity-alias
            android:name=".QuickAssist"
            android:exported="true"
            android:label="@string/quick_label"
            android:targetActivity=".QuickAddActivity">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Separate "Catat cepat" app icon, off until switched on in Pengaturan → Catat cepat.
             Samsung's side key (double press → open app) can only pick launcher icons. -->
        <activity-alias
            android:name=".QuickLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_quick"
            android:roundIcon="@mipmap/ic_quick"
            android:label="@string/quick_label"
            android:targetActivity=".QuickAddActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating quick-add button the user switched on" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".KasWidget"
            android:exported="true"
            android:label="@string/quick_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/kas_widget_info" />
        </receiver>

        <service
            android:name=".KasQsTile"
            android:exported="true"
            android:icon="@drawable/ic_qs_mic"
            android:label="@string/qs_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Answers as an NFC tag holding the invite link while "Kirim lewat NFC" is on -->
        <service
            android:name=".NfcInviteService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/nfc_invite_service" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR scanner on the invite join sheet -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- Fingerprint / face unlock for the app lock (KasBioPlugin) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Catat dengan suara (KasNative uses SpeechRecognizer directly, no Google dialog) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Gelembung melayang (BubbleService) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets SpeechRecognizer find the phone's speech service (package visibility, Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
</manifest>
