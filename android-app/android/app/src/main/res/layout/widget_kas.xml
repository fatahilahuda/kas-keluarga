<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (KasWidget). Only views RemoteViews supports: LinearLayout, TextView, ImageView, ProgressBar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/w_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/w_mark" />

            <TextView
                android:id="@+id/w_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/jakarta_semibold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Muarakas"
                android:textColor="@color/w_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/bricolage_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Catat cepat"
            android:textColor="@color/w_ink"
            android:textSize="22sp" />

        <ProgressBar
            android:id="@+id/w_bar_ok"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:max="100"
            android:progressDrawable="@drawable/w_bar_ok"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/w_bar_warn"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:max="100"
            android:progressDrawable="@drawable/w_bar_warn"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/w_bar_bad"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:max="100"
            android:progressDrawable="@drawable/w_bar_bad"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/jakarta_semibold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Ketuk mikrofon atau keyboard"
            android:textColor="@color/w_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_mic"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/w_btn_accent"
        android:contentDescription="Catat dengan suara"
        android:padding="14dp"
        android:src="@drawable/ic_w_mic" />

    <ImageView
        android:id="@+id/w_kbd"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/w_btn_soft"
        android:contentDescription="Catat dengan mengetik"
        android:padding="14dp"
        android:src="@drawable/ic_w_kbd" />
</LinearLayout>
